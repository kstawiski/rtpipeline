# Licensed RTsegmentator model assets and their isolated runtimes (read-only mounts).
RTSEG_MODEL_BUNDLE=/srv/rtsegmentator/models
RTSEG_RUNTIME_BUNDLE=/srv/rtsegmentator/runtimes
# External portal tasks to enable, comma-separated; TotalSegmentator tasks need no entry.
ENABLED_EXTERNAL_MODELS=
# Portal tasks preselected in the RTpipeline Web UI.
RTPIPELINE_RTSEGMENTATOR_MODELS=total
RETENTION_HOURS=24

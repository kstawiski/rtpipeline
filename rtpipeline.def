Bootstrap: docker
From: kstawiski/rtpipeline:3.0.0

%labels
    Author kstawiski
    Version 3.0.0
    Description DICOM-RT pipeline with TotalSegmentator, nnUNet, and Snakemake
    org.label-schema.name rtpipeline
    org.label-schema.description Radiotherapy DICOM processing pipeline
    org.label-schema.url https://github.com/kstawiski/rtpipeline
    org.label-schema.vcs-url https://github.com/kstawiski/rtpipeline
    org.label-schema.schema-version 1.0

%help
    RTpipeline 3.0.0 - Radiotherapy DICOM Processing Pipeline

    This definition deliberately converts the version-matched canonical Docker
    image built from this repository's Dockerfile by .github/workflows/docker.yml
    (v3.0.0 publishes kstawiski/rtpipeline:3.0.0). It does not build dependencies
    from source. The mandatory %post check rejects an older image or an image
    without the pinned radiomics environment:

      apptainer build rtpipeline-3.0.0.sif rtpipeline.def

    Run the pipeline with explicit data bindings:

      apptainer exec --nv \
        --bind /path/to/input:/data/input:ro \
        --bind /path/to/output:/data/output:rw \
        --bind /path/to/logs:/data/logs:rw \
        rtpipeline-3.0.0.sif \
        snakemake --cores all --configfile /app/config.container.yaml

    For more information, visit https://github.com/kstawiski/rtpipeline.

%post
    set -eu
    cd /app
    export PYTHONNOUSERSITE=1 PYTHONPATH=/app
    export LD_LIBRARY_PATH=/opt/conda/envs/rtpipeline-radiomics/lib:${LD_LIBRARY_PATH:-}
    /opt/conda/envs/rtpipeline-radiomics/bin/python /app/scripts/check_radiomics_environment.py

%environment
    export PYTHONNOUSERSITE=1

%runscript
    cd /app
    exec python webui/app.py "$@"
